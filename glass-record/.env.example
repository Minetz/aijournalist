# Google Cloud
GOOGLE_CLOUD_PROJECT=glass-record-dev
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gemini
GEMINI_MODEL=gemini-1.5-pro-002

# Neo4j (local: bolt://localhost:7687, prod: Aura URI)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword

# Firestore emulator (local only — remove in prod)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_PROJECT_ID=glass-record-dev

# Ghost CMS
GHOST_ADMIN_URL=http://localhost:2368
GHOST_ADMIN_API_KEY=<id>:<secret>

# Google Search
GOOGLE_SEARCH_API_KEY=...
GOOGLE_SEARCH_ENGINE_ID=...

# Cloud Storage (evidence locker)
GCS_EVIDENCE_BUCKET=glass-record-evidence-dev

# Researcher dispatch: "local" (dev) or "pubsub" (Cloud Run)
RESEARCHER_MODE=local

# Pub/Sub topic (used when RESEARCHER_MODE=pubsub)
PUBSUB_RESEARCHER_TOPIC=glass-record-researcher-tasks
