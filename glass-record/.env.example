# Google Cloud (only credential needed — service account handles everything)
GOOGLE_CLOUD_PROJECT=glass-record-dev
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gemini model (gemini-3.1-pro-preview supports Google Search grounding)
GEMINI_MODEL=gemini-3.1-pro-preview

# Firestore emulator (local only — remove in prod)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_PROJECT_ID=glass-record-dev

# Cloud Storage (evidence locker)
GCS_EVIDENCE_BUCKET=glass-record-evidence-dev

# Researcher dispatch: "local" (dev) or "pubsub" (Cloud Run)
RESEARCHER_MODE=local

# Pub/Sub topic (used when RESEARCHER_MODE=pubsub)
PUBSUB_RESEARCHER_TOPIC=glass-record-researcher-tasks
